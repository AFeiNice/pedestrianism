# 复制本文件为 .env 并填写真实值：cp .env.example .env

# 163 邮箱 SMTP 服务器（也可换成 QQ/其他邮箱的 SMTP）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# 发件邮箱（163 账号）
SMTP_USER=your_163_email@163.com
# 163 邮箱「客户端授权密码」：登录网页版 163 邮箱 → 设置 → 客户端授权密码 → 开启后生成
SMTP_PASS=your_authorization_code

# 收件邮箱（报名信息发送到这个邮箱）
MAIL_TO=your_receive_email@163.com

# 可选：允许跨域的来源，多个用逗号分隔；默认 * 允许所有
# ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# 可选：端口，默认 3000
# PORT=3000
